# Lab VM for Shikumi Labs: Linux for Backend Engineers.
# Default: Ubuntu 26.04 LTS.  Alternates (untested): vagrant up fedora | debian
Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.cpus = 2
    vb.memory = 4096
  end
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["numvcpus"] = "2"
    v.vmx["memsize"] = "4096"
  end
  config.vm.provider "parallels" do |prl|
    prl.cpus = 2
    prl.memory = 4096
  end

  {
    "ubuntu" => "bento/ubuntu-26.04",
    "fedora" => "bento/fedora-44",
    "debian" => "bento/debian-13",
  }.each do |name, box|
    primary = (name == "ubuntu")
    config.vm.define name, primary: primary, autostart: primary do |m|
      m.vm.box = box
      m.vm.hostname = "shikumi-#{name}"
      # A second interface the host can reach (Labs 1.3, 9.1, 11.1, 12.2).
      m.vm.network "private_network", type: "dhcp"
      m.vm.provision "shell", path: "provision.sh", args: ["--clone", "vagrant"]
    end
  end
end
